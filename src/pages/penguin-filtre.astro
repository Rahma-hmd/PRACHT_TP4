---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <main class="min-h-screen bg-[#b0c4de] px-6 py-10">
        <div class="max-w-5xl mx-auto">
            <!-- RETOUR ACCUEIL -->
            <a href="/" class="inline-block mb-6 font-semibold"> ← Accueil </a>

            <!-- TITRE -->
            <h1 class="text-4xl font-bold mb-3">Penguin avec filtre</h1>

            <p class="mb-8">Choisissez une espèce pour filtrer le graphique.</p>

            <!-- CARTE -->
            <div class="bg-white rounded-xl shadow-lg p-8">
                <!-- MENU DÉROULANT -->
                <div class="mb-8">
                    <label for="species" class="block font-semibold mb-2">
                        Choisir une espèce :
                    </label>

                    <select
                        name="species"
                        id="species"
                        class="select bg-white border border-gray-300 w-64"
                    >
                        <option value="">All species</option>
                        <option value="Adelie">Adelie</option>
                        <option value="Chinstrap">Chinstrap</option>
                        <option value="Gentoo">Gentoo</option>
                    </select>
                </div>

                <!-- GRAPHIQUE -->
                <h2 class="text-2xl font-bold mb-6">Comparaison des espèces</h2>

                <div id="graphique" class="overflow-x-auto">
                    Chargement du graphique...
                </div>
            </div>
        </div>
    </main>
</Layout>

<script>
    import * as Plot from "@observablehq/plot";
    import penguins from "../assets/penguins.json";

    // 1. Récupérer les éléments HTML
    const selectSpecies = document.querySelector<HTMLSelectElement>("#species");

    const divGraphique = document.querySelector<HTMLDivElement>("#graphique");

    // 2. Fonction qui affiche le graphique
    function renderPlot() {
        if (!selectSpecies || !divGraphique) {
            return;
        }

        // Récupérer l'espèce sélectionnée
        const species = selectSpecies.value;

        // Filtrer les données
        const penguinsFiltres = penguins.filter((penguin) => {
            return species === "" || penguin.species === species;
        });

        // Vider l'ancien graphique
        divGraphique.innerHTML = "";

        // Créer le nouveau graphique
        const graphique = Plot.plot({
            width: 800,
            height: 500,

            grid: true,

            x: {
                label: "Longueur du bec (mm)",
            },

            y: {
                label: "Profondeur du bec (mm)",
            },

            color: {
                legend: true,
            },

            marks: [
                Plot.dot(penguinsFiltres, {
                    x: "culmen_length_mm",
                    y: "culmen_depth_mm",
                    stroke: "species",
                }),
            ],
        });

        // Ajouter le nouveau graphique dans la page
        divGraphique.append(graphique);
    }

    // 3. Mettre à jour le graphique quand le select change
    selectSpecies?.addEventListener("change", renderPlot);

    // 4. Afficher le graphique au chargement de la page
    renderPlot();
</script>
